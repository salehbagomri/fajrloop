<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:layoutDirection="rtl"
    android:gravity="center">

    <!-- أيقونة رأسية تعبيرية -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="#1AFFD700"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💌"
            android:textSize="28sp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- عنوان الحوار -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رمز دعوة الصديق"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- اسم الحلقة -->
    <TextView
        android:id="@+id/txt_halqa_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حلقة الفجر المباركة"
        android:textColor="#E0E0FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_code_container"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="14dp" />

    <!-- نص الوصف -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="شارك هذا الرمز مع صديقك للانضمام إلى سلسلتك والاستيقاظ معاً لصلاة الفجر."
        android:textColor="#B0B0C5"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- كارت الرمز مع زر النسخ السريع داخل الصندوق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_code_container"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <!-- الرمز النصي الكبير -->
        <TextView
            android:id="@+id/txt_invite_code"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FJR-XXXX"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:gravity="center" />

        <!-- زر نسخ سريع مع أيقونة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_copy"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="نسخ"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_copy"
            app:iconTint="#FFD700"
            app:iconSize="16dp"
            app:strokeColor="#40FFD700"
            app:strokeWidth="1dp"
            app:backgroundTint="#1AFFD700"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- أزرار الإجراءات (إغلاق ومشاركة) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- زر إغلاق -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="إغلاق"
            android:textColor="#B0B0C5"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="#40B0B0C5"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- زر مشاركة الكود الذهبي المميز -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_invite"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:layout_height="48dp"
            android:text="مشاركة الرمز 🔗"
            android:textColor="#07071B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FFD700"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
